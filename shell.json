{
    "appearance": {
        "font": {
            "family": {
                "mono": "JetBrainsMono NF"
            }
        },
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "desktopClock": {
            "background": {
                "enabled": true
            },
            "enabled": true,
            "position": "top-right"
        },
        "visualiser": {
            "enabled": true
        }
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "inverted": true
        },
        "clock": {
            "background": true,
            "showDate": true
        },
        "status": {
            "showAudio": true,
            "showKbLayout": true,
            "showMicrophone": true
        },
        "tray": {
            "background": true,
            "compact": true,
            "recolour": true
        },
        "workspaces": {
            "occupiedBg": true,
            "shown": 10
        }
    },
    "general": {
        "idle": {
            "inhibitWhenAudio": true,
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "idleAction": [
                        "hyprlock"
                    ],
                    "timeout": 180
                },
                {
                    "idleAction": "dpms off",
                    "returnAction": "dpms on",
                    "timeout": 600
                },
                {
                    "idleAction": [
                        "systemctl",
                        "suspend"
                    ],
                    "timeout": 900
                }
            ]
        }
    },
    "launcher": {
        "maxShown": 5,
        "maxWallpapers": 5,
        "showOnHover": true,
        "useFuzzy": {
            "apps": true
        }
    },
    "lock": {
        "recolourLogo": true
    },
    "notifs": {
        "defaultExpireTimeout": 3000
    },
    "services": {
        "showLyrics": true,
        "useFahrenheit": false,
        "useFahrenheitPerformance": false,
        "useTwelveHourClock": false
    },
    "utilities": {
        "maxToasts": 3
    }
}
